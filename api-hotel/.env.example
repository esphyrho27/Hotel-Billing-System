# Copy to api-hotel/.env for local XAMPP use. Replace values for your machine.
HOTEL_DB_HOST=127.0.0.1
HOTEL_DB_NAME=hotel_billing_system
HOTEL_DB_USER=root
HOTEL_DB_PASS=
HOTEL_TIMEZONE=Asia/Manila
HOTEL_SERVER_IP=127.0.0.1
HOTEL_PORTAL_BASE_URL=http://localhost:3000/portal.php
HOTEL_SESSION_SECURE=0

# Used only when the users table is empty. Set a unique username and a strong,
# one-time password before the first API request. Never use a shared default.
HOTEL_BOOTSTRAP_ADMIN_USERNAME=replace_with_admin_username
HOTEL_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
