# TiDB Cloud Serverless connection (from your TiDB Cloud console: cluster > Connect)
# Use the host/port/user/password shown for your cluster. Do NOT commit real values.
DATABASE_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
DATABASE_PORT=4000
DATABASE_USER=root
DATABASE_PASSWORD=your-password
DATABASE_NAME=db_hotel_billing

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
